{
  "name": "agentor-browser",
  "version": "0.2.0",
  "private": true,
  "description": "Pi-native Tor browser backend. Scrapes clearnet HTTP/HTTPS and .onion through a client built from official Tor Project source.",
  "type": "module",
  "bin": {
    "agentor": "./bin/agentor.js"
  },
  "scripts": {
    "vendor": "bash scripts/vendor-tor.sh",
    "build:tor": "bash scripts/build-tor.sh",
    "start": "node bin/agentor.js daemon",
    "test": "node --experimental-strip-types --test test/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "deps": "bash scripts/install-builtin-deps.sh"
  },
  "keywords": [
    "pi-package",
    "tor",
    "agent"
  ],
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "turndown": "^7.2.0",
    "undici": "^7.29.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^22.15.0",
    "@types/turndown": "^5.0.5",
    "typebox": "1.3.27",
    "typescript": "^5.8.3"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts/*.md"
    ]
  },
  "agentor": {
    "builtinDeps": [
      "autoconf",
      "automake",
      "libtool",
      "pkgconf",
      "libevent",
      "openssl@3"
    ]
  }
}
